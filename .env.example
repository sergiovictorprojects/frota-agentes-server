# Copie para .env (local) ou configure no painel do Railway. Nunca versione valores reais.

# Obrigatórias
DATABASE_URL=postgres://usuario:senha@host:5432/frota
ANTHROPIC_API_KEY=sk-ant-substitua-por-uma-chave-dedicada
UI_PASSWORD=troque-por-uma-senha-longa-e-aleatoria
PUBLIC_BASE_URL=https://frota.exemplo.com

# Opcionais (valores padrão mostrados)
PORT=3000
UI_USER=frota
CRON_PROCESSAR_FILA=*/10 * * * *
MONTHLY_BUDGET_USD=50
MAX_DEMANDAS_POR_RUN=3
MODEL_WORK=claude-sonnet-5
MODEL_AUDIT=claude-sonnet-5
STALE_CLAIM_MINUTES=60
